// 02 — Ciclo de vida de la sesión (cortex)  ·  FUENTE editable (Graphviz .dot)
// Render:  dot -Tsvg 02-ciclo-de-vida-de-la-sesion.dot -o 02-ciclo-de-vida-de-la-sesion.svg
// Completado 2026-07-29: el esqueleto ya era bueno; se AÑADEN los 2 hooks de SessionStart que faltaban
// y que MUTAN git (aviso-drift-cerebro, barrer-ramas), el estado de CIERRE de sesión y la LEYENDA.
// Corregido 2026-09-07 (hallazgos de auditoría): SessionStart cablea SEIS hooks reales, no cuatro —
// install-brain.sh (ev_de → SessionStart): rehidratar-hilo, aviso-drift-cerebro, hud-stale, barrer-ramas
// (4 GLOBALES) + sesion-inicio y recordar-unificar-cerebro (2 POR-REPO, tier "repo"/"both" del MANIFEST).
digraph flujos {
  graph [bgcolor="#1b1712", rankdir=TB, fontname="Helvetica", splines=true,
         nodesep=0.35, ranksep=0.55, pad=0.25];
  node  [fontname="Helvetica", fontsize=12, fontcolor="#f2ede6", shape=box,
         style="rounded,filled", fillcolor="#2b2b2b", color="#8a8a8a", penwidth=1.5];
  edge  [color="#d97757", fontname="Helvetica", fontsize=10, fontcolor="#cfc8c0", penwidth=1.4];

  // ─────────────────────────── LEYENDA (regla dura del skill diagramar) ───────────────────────────
  // >>> LEYENDA-ARBOL (generado por gen-leyenda-arbol.sh desde el árbol del README — NO editar a mano) >>>
  subgraph cluster_leyenda {
    label="LEYENDA — árbol completo del cerebro (fuente: README.md)"; labeljust="l"; fontname="Times"; fontsize=14; fontcolor="#5fa89e";
    color="#5fa89e"; penwidth=1.6; style="rounded"; bgcolor="#1b1712";
    LEY_ARBOL [shape=none, margin=0, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#5fa89e" bgcolor="#1b1712">
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>🔒 Hooks Forzosos</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🚧 git-branch-guard</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">push/merge a develop·main → denegado</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔗 merge-squash-guard</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">MR a develop sin --squash → denegado</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🕵️ secret-scan</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">commit/push con un secreto → denegado</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💸 delegacion-gate</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">delegar al llegar al 90% de tu ventana 5h → pide tu OK</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🛑 limite-gasto</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">sin ventana 5h Y sin overage (ambos agotados) → freno duro</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">✋ confirmar-merge-develop</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">merge sin tu OK → denegado</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">✅ dod-verificar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">cierre sin evidencia/OK → denegado; claim visual a ciegas (sin ver la pantalla) también</font></td></tr>
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>🔔 Automático</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📊 recordar-dashboard</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">en el push recuerda dashboard + doc=realidad (README/docs) — cierre del slice</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🖥️ entorno-maquina-guard</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">commit de algo machine-specific (aliases/rutas de $HOME/Rosetta/entorno-maquina.md) al .claude/memory/ del repo → avisa</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🚧 no-bypass-deploy</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">correr el instalador/deploy a mano (install-brain.sh/deploy.sh) en vez de la herramienta oficial (el widget) → avisa (fail-safe: no --dry-run/--help/CI)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🕰️ rama-vieja</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">avisa si la ramita arrastra base vieja</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌳 proteger-arbol</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">git destructivo que orfanaría commits sin pushear → avisa (fan-out: usa worktree aislado)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🛡️ proteger-fuente-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">editar la copia INSTALADA de un hook/skill que tiene fuente en el clon → avisa (se perdería en el próximo sync) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧹 barrer-ramas</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">al abrir sesión / al punto del merge barre en 2º plano ramas locales + remota huérfana + worktrees ya integrados (zombie squash-safe; throttle 24h) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💾 exportar-sesion-master</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">auto-export de las sesiones *-master a ~/.claude-sessions (o Drive); detached, sobrevive el cleanup de 30 días (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📝 delegacion-registrar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">materializa el "pregunta una sola vez"</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📮 delegacion-reporte</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">al terminar un agente: recuerda registrar avance + limpiar su worktree</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🎼 recordar-orquestar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">N mutaciones (edits/commits) en serie SIN delegar → sugiere fan-out (advisory, no bloquea; resetea al delegar) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧵 rehidratar-hilo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reinyecta hilo-mental-actual.md al abrir/retomar/compactar (GLOBAL) — con gate de frescura</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📈 aviso-contexto</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reporta el watermark de contexto CRUDO (tokens · ventana · %); sin bandas ni veredicto — /context manda (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧬 aviso-drift-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">repo brained atrás de la fuente única (hooks/libs Y skills) → en tu mini-develop se AUTO-SINCRONIZA (apply+commit+push); en otra rama, avisa. ADEMÁS detecta el drift de la copia GLOBAL de skills (~/.claude/skills vs la fuente; warn-only, throttle propio). Al moverse el cerebro, NUDGE a correr la DUPLA (suficiencia+coherencia; contra la firma si hay AGENTS.md, si no sugiere instanciarla) (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔀 hud-stale</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">cambiaste de rama/proyecto → tu lista de TODOs (HUD) puede ser de la tarea anterior: avisa (advisory) que la resetees/re-siembres del estado-proyecto.md de esa rama. Señal OBJETIVA (rama/cwd), stamp per-sesión, first-sight silencioso, solo en repos con backlog (GLOBAL)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧭 sesion-inicio</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reinyecta rama + norma + memoria al abrir</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌾 recordar-cosechar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">espejo TaskList→estado-proyecto.md (auto) + nudge: no cosechaste/no actualizaste backlog</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">⬆️ recordar-unificar-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">tu mini acumuló aprendizajes sin UNIFICAR a develop → sugiere /unificar-cerebro (gemelo ↑ de aviso-drift)</font></td></tr>
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>📜 Normas</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🎯 Definition of Done</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">verde técnico ≠ Done/Listo/Ya Quedó; exige QA o un OK explícito</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🪞 Doc &lt;= realidad</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">cambió algo → su doc se actualiza en la tanda</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌿 Flujo de git</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">ramita → MR → develop; main es release-only</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💰 Costo de delegación</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">gratis / incluido / con costo, según tu cuota</font></td></tr>
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>💡 Skills</b></font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📦 cerrar-slice</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">build+tests+memoria al día + MR con resumen curado</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💾 checkpoint</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">vuelca el HILO a memoria para compactar sin perderlo (proactivo)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🗂️ to-do</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">carga la interfaz de tareas del harness desde el backlog durable (estado-proyecto.md)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">💧 rehidratar-hilo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">relee el HILO a mano (gemelo del hook; respaldo si un update del CLI rompe el auto-rehidratado)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🐝 orquestar-fanout</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">fan-out sin niñera: asigna del backlog, auto-reporta y limpia al cerrar</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🗺️ diagramar</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">diagramas por destino: .dot→dot2yed→yEd (editar a mano) · Mermaid en .md versionado (verse en GitHub)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔬 auditar-proceso-algoritmo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">auditor experto read-only (proceso industrial + algoritmo) → hallazgos priorizados; se alimenta de los flowcharts de diagramar</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🩺 auditar-coherencia-cerebro fan-out read-only sobre el PROPIO cerebro (guards+flowcharts+doc): evasiones/huecos/drift, verificado por ejecución → loop hasta converger; modo-cerebro de auditar-proceso-algoritmo</font></td><td bgcolor="#1b1712"><font color="#cfc8c0"> </font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧪 auditar-suficiencia-operativa</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">¿ALCANZA la doc para HACER el trabajo sin romper nada ni re-investigar? tareas reales ✅/⚠️/❌ con archivo:línea + RE-auditar tras arreglar</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧬 auditor-semantico</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">¿el código HACE lo que queremos? Capa 1 checks deterministas (scripts/, gratis, en CI) + Capa 2 criterio LLM sobre invariantes-semanticos.yml; motor genérico, catálogo por-repo</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧠 consolidar-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">meta-orquestador: dupla → positivar → desinflar → convergencia → cierre con la FIRMA (CLAUDE+MEMORY)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📐 canonizar-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">lleva un cerebro instanciado drifteado a la firma-árbol: reprefija memorias (git mv) a dom-/dev-/ux-/qa-, reescribe CLAUDE.md+MEMORY.md, verifica 1:1 con verificar-firma-canonica.sh (detector del GATE #44)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🪶 desinflar-memorias</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">adelgaza un árbol de memorias sin perder lecciones: la narrativa se colapsa a su lección, los mitos descartados se mudan al cementerio.md (una lápida por ID content-hash 🪦#&lt;id&gt;)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🕵️ revisar-entregables-agentes</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">verifica lo que un agente ENTREGA contra la realidad; no relates su reporte como verdad</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">☀️ positivar-doc</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reescribe answer-first: 'ESTO SÍ' (método correcto) antes del 'ESTO NO'</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🎓 investigar-dominio</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">ponte experto en un dominio (fan-out DOC-FIRST) → memorias durables + skills</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📚 construir-missing-manual</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">fabrica el manual/wiki de referencia exhaustivo que no existe (fan-out que investiga 1× y hornea) → artefacto consultable OFFLINE</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌾 cosechar-sesion</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">cosecha local: extrae aprendizajes de tu sesión al inbox del equipo</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧩 unificar-cerebro</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">reconciliación del cerebro del equipo: integra los aprendizajes mini→develop</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🧳 claude-proyecto-autocontenido</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">el cerebro VIVE dentro del proyecto (.claude/ + symlink de slug) → viaja con él</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🚚 reubicar-master</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">muda una sesión master COMPLETA a otro repo (brain-master → cortex) sin residuo: transcript+cwd, cerebro, slug y refs atómicas</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔍 zoom-screenshot</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">recorta y amplía regiones de una captura (ffmpeg) para leer texto fino ilegible</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🔩 ingenieria-inversa-gui-db-navegador</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">ingeniería inversa de app legacy GUI+BD: driving la UI vía navegador + diff de la BD antes/después = doc con evidencia real</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">📕 markdown-a-pdf</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">convierte .md a PDF pulido y distribuible vía md-to-pdf (npx, sin instalar) con el gotcha de --css y QA visual real</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">🌙 turno-nocturno</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">protocolo del turno de noche: eco del contrato, decide-dentro-de-la-cerca, grants durables a disco</font></td></tr>
      </table>>];
    LEY_VAL [shape=none, margin=0, label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#5fa89e" bgcolor="#1b1712">
        <tr><td colspan="2" bgcolor="#2b2622"><font color="#d97757"><b>valencia de color</b></font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#7fb069"><font color="#f2ede6">🟢</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">OK / pasa</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#e08e45"><font color="#f2ede6">🟠</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">aviso / ASK (no bloquea)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#c9a227"><font color="#f2ede6">🟡</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">latente / frágil (funciona hoy, sin garantía)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#c0392b"><font color="#f2ede6">🔴</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">DENY / bloqueo (guard OK)</font></td></tr>
        <tr><td bgcolor="#2b2b2b" border="2" color="#9e9e9e"><font color="#f2ede6">🚧</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">hueco / deuda (por construir)</font></td></tr>
        <tr><td bgcolor="#1b1712"><font color="#f2ede6">⚠</font></td><td bgcolor="#1b1712"><font color="#cfc8c0">el paso ESCRIBE git</font></td></tr>
      </table>>];
    LEY_ARBOL -> LEY_VAL [style=invis];
  }
  // <<< LEYENDA-ARBOL <<<

  // ───────────────────────────────────── EL CICLO ─────────────────────────────────────
  subgraph cluster_f0 {
    label="02 · Ciclo de vida de la sesión   (bootstrap 1× · SessionStart cablea 6 hooks (4 globales + 2 por-repo) · 💾 checkpoint vuelca el hilo · 🔔 aviso-contexto = reportero del watermark de contexto · SessionEnd)";
    fontname="Times"; fontsize=14; fontcolor="#5fa89e";
    color="#5fa89e"; penwidth=1.6; style="rounded"; bgcolor="#1b1712";

    OPEN   [fillcolor="#232323", color="#8a8a8a", fontcolor="#cfc8c0",
            label="abres Claude Code en un folder"];
    GIT    [shape=diamond, fillcolor="#2b2622", color="#d97757",
            label="¿repo git CON .claude/\n(cerebro autocontenido)?"];
    PLAIN  [color="#7fb069",
            label="🟢  folder simple: sin hooks del repo;\naplican solo los hooks GLOBALES de la máquina\n(en repos personales → auto-mode genérico · P10)"];
    BOOT   [fillcolor="#232323", color="#8a8a8a", fontcolor="#cfc8c0",
            label="🔧  bootstrap-claude.sh (UNA vez tras clonar)\ninstala hooks GLOBALES + enlaza el cerebro + verifica git & jq;\nlos hooks del repo se cablean en .claude/settings.json (viajan por git)"];

    // ── SessionStart: NODO-EVENTO neutro (no un hook) del que abanican los SEIS hooks como PARES ──
    // sin orden garantizado ni causalidad entre ellos (CONVENCIONES §6: el fan-out cuelga del EVENTO,
    // nunca de un hook-par; ninguno invoca a los otros).
    SESSTART [shape=box, style="rounded,filled", fillcolor="#2b2622", color="#5fa89e", fontcolor="#5fa89e",
            label="⬜  evento SessionStart\nsource: startup / resume / compact / clear / fork\nabanica 6 hooks EN PARALELO, sin orden garantizado"];

    // ── SessionStart: los SEIS hooks reales (4 GLOBALES vía install-brain.sh ev_de + 2 POR-REPO: sesion-inicio, recordar-unificar-cerebro) ──
    START  [color="#e08e45",
            label="🔔🧭  sesion-inicio  (SessionStart · POR-REPO)"];
    INJECT [color="#e08e45",
            label="🟠  inyecta additionalContext: rama actual + NORMA de git\n+ ritual anti-hilo (lee MEMORY.md + AGENTS.md; NO declares LISTO sin evidencia)\n+ avisa si lo que ves es de otra rama (P16)\n📜 → 🌿 Flujo de git · 🎯 Def. de LISTO"];
    REHID  [color="#e08e45",
            label="🔔🧵  rehidratar-hilo  (SessionStart · GLOBAL)\nreinyecta hilo-mental-actual.md si existe → el HILO vuelve\n+ GATE DE FRESCURA — la RAMA es la señal fuerte, no un OR con la edad:\n  rama del hilo ≠ rama actual → «⚠️ posiblemente OBSOLETO»\n  rama COINCIDE → vigente SIN IMPORTAR la edad (una sesión de 13h en la misma rama sigue viva, FMEA A8)\n  rama INDETERMINADA (sin git / sin línea de rama en el hilo) → cae al proxy mtime>HILO_STALE_HORAS (12h)\n(YA NO fija baseline de contexto: aviso-contexto mide tokens reales anclados al /compact)"];

    // ── LOS DOS QUE FALTABAN — y MUTAN git (borde rojo grueso) ──
    DRIFT  [color="#c0392b", penwidth=3,
            label="⚠ ESCRIBE git (condicional) · 🔔🧬  aviso-drift-cerebro  (SessionStart · GLOBAL)\nen TODO SessionStart, ANTES del throttle: re-inyecta conocimiento-propio.md (identidad del repo,\nimborrable) + avisa drift de la copia GLOBAL de skills (throttle propio) + avisa migración\n~/.claude-brain→~/.cortex si el clon quedó con el nombre viejo. El chequeo PER-REPO de drift\nva THROTTLEADO a AVISO_DRIFT_HORAS (default 6h, solo cachea resultados LIMPIOS) y corre\nsincronizar-cerebro en DRY-RUN (diff por contenido vs ~/.cortex). REDISEÑO #46 bifurca por la\nmarca .claude/repo-compartido:\n  repo COMPARTIDO (tiene la marca) + rama Develop* + .claude/ LIMPIO → --apply + commit + PUSH SOLO\n  repo PERSONAL (SIN la marca, el DEFAULT) → NUNCA auto-commit/push; solo FLAGGEA guards que sobran\nFAIL-OPEN SIEMPRE: sin clon canónico ~/.cortex / repo no-brained / cualquier error del sync → silencio;\nsin jq → degrada a printf plano (igual que sesion-inicio/rehidratar-hilo, NO como aviso-contexto que queda mudo)\n↳ es la pieza de SESIÓN del flujo de PROPAGACIÓN del cerebro (ver 01)"];
    BARRER [color="#c0392b", penwidth=3,
            label="⚠ ESCRIBE git · 🔔🧹  barrer-ramas  (SessionStart · GLOBAL)\nthrottle 24h; lanza limpiar-ramas.sh DETACHED (nohup) que hace `git branch -d`\nde ramas zombie ya integradas (squash-merge / remota borrada / equivalencia de parche).\nConserva trabajo sin integrar; NUNCA toca actual/base/develop/main/Develop*/keep/*"];
    HUD    [color="#e08e45",
            label="🔔🔀  hud-stale  (SessionStart · GLOBAL, tier \"both\")\nadvisory, NO bloquea: si cambiaste de rama/cwd, tu lista de TODOs (HUD) puede ser\nde la tarea anterior → avisa resetear/re-sembrar del estado-proyecto.md de ESA rama.\nSeñal OBJETIVA (rama/cwd, no el contenido del HUD); stamp per-sesión; first-sight silencioso"];
    UNIF   [color="#e08e45",
            label="🔔⬆️  recordar-unificar-cerebro  (SessionStart · POR-REPO)\ngemelo ↑ de aviso-drift: cuenta el delta de .claude/ de TU rama vs origin/develop;\nsi supera el umbral (≥5 archivos O >7 días) → nudge PASIVO a /unificar-cerebro\nNO escribe nada al árbol; throttle 1 aviso/día por repo; fail-open (sin git/jq/origin → silencio)"];
    RACE   [color="#c9a227",
            label="🟡  co-disparo: aviso-drift (commit/push) y barrer-ramas (branch -d, detached)\nen el MISMO SessionStart sobre el MISMO .git → posible choque en index.lock/ref-locks\n(el proceso detached amplía la ventana). Supuesto de independencia sin serializar"];

    // ── Decisiones de sesion-inicio ──
    PROT   [shape=diamond, fillcolor="#2b2622", color="#d97757", label="¿rama = develop/main?"];
    PROTW  [color="#e08e45", label="🟠  + aviso: rama PROTEGIDA →\nsaca una ramita feat/… desde develop"];
    EST    [shape=diamond, fillcolor="#2b2622", color="#d97757", label="¿existe\nestado-proyecto.md?"];
    ESTW   [color="#e08e45", label="🟠  + inyecta su Resumen\n(dónde quedó el avance)"];
    READY  [color="#7fb069", label="🟢  contexto rehidratado → a trabajar\n(sin perder el hilo entre sesiones/compus)"];

    // ── Durante la corrida: watermark + checkpoint ──
    AVISO  [color="#e08e45",
            label="🔔📈  aviso-contexto  (PostToolUse · GLOBAL · watermark)\nmétrica = TOKENS REALES del último `usage`, ANCLADO al último /compact (isCompactSummary descarta el usage viejo pre-compact)\nREPORTERO TONTO: surface ctx · ventana: [1m] O modelo 1M-nativo (opus-4-7/4-8/5, sonnet-5, fable-5, mythos-5) → 1M,\nsi no → 200K · auto-corrige a 1M si ctx>ventana (invariante físico) · % · autoCompactWindow — SIN techo derivado ni bandas\ndebounce por escalón de 50K; /context manda, tú decides (sin veredicto de urgencia)\nFAIL-OPEN silencioso (exit 0, sin ruido) sin jq · sin transcript · sin .claude/memory en el repo\n(p. ej. un folder PLAIN nunca reporta) — sin jq queda MUDO, a diferencia de sesion-inicio/rehidratar-hilo\nque degradan a texto plano"];
    CHECK  [color="#7fb069",
            label="💾  checkpoint  (skill — TÚ lo invocas, PROACTIVO)\nvuelca el HILO → .claude/memory/hilo-mental-actual.md\n📜 → 🪞 doc=realidad · 💡 cerrar-slice §2 hace este mismo volcado"];

    // ── CIERRE de sesión ──
    END    [color="#e08e45",
            label="🔚  Stop / SessionEnd / PreCompact → 💾 exportar-sesion-master.sh\nSÍ es un hook GLOBAL del cerebro: vive en brain/hooks/, listado en brain/hooks/MANIFEST\ny cableado por install-brain.sh (ev_de → \"Stop| SessionEnd| PreCompact|\").\nExporta el transcript comprimido de una sesión *-master a ~/.claude-sessions (o Drive) —\nsobrevive el cleanup de 30 días y viaja cross-máquina. No muta git (no lleva ⚠)"];

    // Aristas
    OPEN -> GIT;
    GIT -> PLAIN    [label="no"];
    GIT -> BOOT     [label="1ª vez tras clonar\n(bootstrap, UNA vez)"];
    GIT -> SESSTART [label="sí (repo con cerebro) — CADA sesión"];
    BOOT -> SESSTART;

    // Los 6 hooks son PARES que cuelgan del EVENTO SessionStart, no unos de otros (sin orden garantizado)
    SESSTART -> START  [label="par 1/6 (por-repo)"];
    SESSTART -> REHID  [label="par 2/6 (global)"];
    SESSTART -> DRIFT  [label="par 3/6 (global) ⚠"];
    SESSTART -> BARRER [label="par 4/6 (global) ⚠"];
    SESSTART -> HUD    [label="par 5/6 (global, tier \"both\")"];
    SESSTART -> UNIF   [label="par 6/6 (por-repo)"];
    DRIFT -> RACE   [style=dashed];
    BARRER -> RACE  [style=dashed];

    // sesion-inicio (START) es UNO de los 6 pares; su lógica INTERNA (no el fan-out) sigue este spine:
    START -> INJECT;
    INJECT -> PROT;
    PROT -> PROTW [label="sí"];
    PROT -> EST   [label="no"];
    PROTW -> EST;
    EST -> ESTW  [label="sí"];
    EST -> READY [label="no"];
    ESTW -> READY;
    REHID -> READY;

    READY -> AVISO [label="durante la corrida\n(vigila cada tool)"];
    READY -> CHECK [label="o TÚ en una pausa\n(proactivo)"];
    AVISO -> CHECK [label="cruza un escalón de 50K →\nreporta ctx/ventana/%; TÚ decides\n(seguir / checkpoint / compact)"];
    CHECK -> SESSTART [label="/compact o auto-compact →\nSessionStart source=compact:\nRE-DISPARA LOS 6 hooks (no solo rehidratar-hilo),\nincl. ⚠ aviso-drift (auto-sync commit+push en tu\nmini-develop) y ⚠ barrer-ramas (branch -d detached)"];
    REHID -> READY [label="hilo restaurado →\nsigue sin perderlo"];

    READY -> END [label="cierras / Stop / compacta"];
  }
}
